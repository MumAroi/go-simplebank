POSTGRES_CONTAINER_NAME=simplebank-postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_DB=simple_bank
POSTGRES_PORT=5432

DB_DRIVER=postgres
DB_SOURCE=postgresql://root:secret@postgresql:5432/simple_bank?sslmode=disable
SERVER_ADDRESS=0.0.0.0:3010
TOKEN_SYMMETRIC_KEY=12345678901234567890123456789012
ACCESS_TOKEN_DURATION=15m

GIN_MODE=debug

API_PORT=3010
API_CONTAINER_NAME=api
